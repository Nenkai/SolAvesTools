<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NenTools\NenTools.IO.Streams\NenTools.IO.Streams.csproj" />
    <ProjectReference Include="..\NenTools\NenTools.Utils\NenTools.Utils.csproj" />
    <ProjectReference Include="..\SolAvesTools.Assets\SolAvesTools.Assets.csproj" />
    <ProjectReference Include="..\SolAvesTools.Files\SolAvesTools.Files.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
